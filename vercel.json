{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:production",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/editor-inplace", "destination": "/index.html" },
    { "source": "/editor-inplace/:path*", "destination": "/:path*" }
  ]
}
